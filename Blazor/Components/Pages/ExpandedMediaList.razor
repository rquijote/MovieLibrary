@page "/{mediaType}/{category}"
@inject IHttpClientFactory httpClientFactory;
@using static Blazor.Components.Enums;
@using Application.Models.Dto.Responses;
@using Blazor.Components.Shared.MediaGrid;

@if (isValidRoute)
{
	<h1>Expanded Media List</h1>

	<p>Media Type: @mediaType</p> 
	<p>Category: @category</p>
	<p>Endpoint: @endpoint</p>

	@if (mediaList != null)
	{
		<div class="pagination-controls">
			@if (pageNum > 1)
			{
				<button @onclick="GoToPreviousPage">← Previous</button>
			}
			<span>Page @pageNum</span>
			<button @onclick="GoToNextPage">Next →</button>
		</div>

		<MediaGrid Items="@mediaList" MediaType="@parsedMediaType" />
	}
}
else
{
	<Blazor.Components.Shared.NotFound.NotFoundMessage />
}

@code {
	[Parameter]
	public string mediaType { get; set; } = string.Empty;

	[Parameter]
	public string category { get; set; } = string.Empty;

	private bool isValidRoute = false;
	private MediaType parsedMediaType;
	private Category parsedCategory;
	private string? endpoint;
	private object? mediaList;
	private int pageNum;

	protected override async Task OnInitializedAsync()
	{
		// Parse and validate URL parameters
		bool validMediaType = Enum.TryParse<MediaType>(mediaType, true, out parsedMediaType);
		bool validCategory = Enum.TryParse<Category>(category.Replace("-", ""), true, out parsedCategory);

		// Set flag based on validation
		isValidRoute = validMediaType && validCategory;

		if (isValidRoute)
		{
			pageNum = 1;
			endpoint = BuildEndpoint(pageNum);
			await LoadMedia();
		}
	}

	private async Task LoadMedia()
	{
		var client = httpClientFactory.CreateClient("MovieLibraryApi");

		if (parsedMediaType == MediaType.Movies)
		{
			var response = await client.GetFromJsonAsync<MovieListResponseDto>(endpoint);
			mediaList = response?.Results;
		} 
		else if (parsedMediaType == MediaType.Tv)
		{
			var response = await client.GetFromJsonAsync<TvShowListResponseDto>(endpoint);
			mediaList = response?.Results;
		}
	}

	private string BuildEndpoint(int pageNum)
	{
		var baseEndpoint = (parsedMediaType, parsedCategory) switch
		{
			// Movie Lists
			(MediaType.Movies, Category.Popular) => "/api/MovieLists/popular",
			(MediaType.Movies, Category.TopRated) => "/api/MovieLists/top-rated",
			(MediaType.Movies, Category.NowPlaying) => "/api/MovieLists/now-playing",
			(MediaType.Movies, Category.Upcoming) => "/api/MovieLists/upcoming",

			// TV Lists
			(MediaType.Tv, Category.Popular) => "/api/TvShowLists/popular",
			(MediaType.Tv, Category.TopRated) => "/api/TvShowLists/top-rated",
			(MediaType.Tv, Category.AiringToday) => "/api/TvShowLists/airing-today",
			(MediaType.Tv, Category.OnTheAir) => "/api/TvShowLists/on-the-air",

			// Trending (different controller + query param)
			(MediaType.Movies, Category.Trending) => "/api/Trending/movies?timeWindow=day",
			(MediaType.Tv, Category.Trending) => "/api/Trending/tv?timeWindow=day",

			// Account - Watchlist
			(MediaType.Movies, Category.Watchlist) => "/api/Account/watchlist/movies",
			(MediaType.Tv, Category.Watchlist) => "/api/Account/watchlist/tv",

			// Account - Favorites
			(MediaType.Movies, Category.Favorite) => "/api/Account/favourite/movies",
			(MediaType.Tv, Category.Favorite) => "/api/Account/favourite/tv",

			_ => "/"
		};

		// Add page parameter - check if query params already exist
		var separator = baseEndpoint.Contains('?') ? "&" : "?";
		return $"{baseEndpoint}{separator}page={pageNum}";
	}

	private async Task GoToNextPage()
	{
		pageNum++;
		endpoint = BuildEndpoint(pageNum);
		await LoadMedia();
	}

	private async Task GoToPreviousPage()
	{
		if (pageNum > 1)
		{
			pageNum--;
			endpoint = BuildEndpoint(pageNum);
			await LoadMedia();
		}
	}
}
