@page "/lists"
@inject IHttpClientFactory HttpClientFactory
@using Application.Models.Dto.Responses;

<PageTitle>Lists</PageTitle>

<h1>My Lists</h1>

@if (favoriteMovies == null || favoriteTV == null)
{
	<p>Loading...</p>
}
else
{
	<h3>Favorite Movies</h3>
	@foreach (var movie in favoriteMovies.Results)
	{
		<div>@movie.Id: @movie.Title</div>
	}
	<p>Page @favoriteMovies.Page of @favoriteMovies.TotalPages</p>

	<h3>Favorite TV Shows</h3>
	@foreach (var tv in favoriteTV.Results)
	{
		<div>@tv.Id: @tv.Name</div>
	}
	<p>Page @favoriteTV.Page of @favoriteTV.TotalPages</p>
}

@code {
	private MovieListResponseDto? favoriteMovies;
	private TvShowListResponseDto? favoriteTV;

	protected override async Task OnInitializedAsync()
	{
		var client = HttpClientFactory.CreateClient("MovieLibraryApi");
		favoriteMovies = await client.GetFromJsonAsync<MovieListResponseDto>("/api/Account/favourite/movies");
		favoriteTV = await client.GetFromJsonAsync<TvShowListResponseDto>("/api/Account/favourite/tv");
	}
}
