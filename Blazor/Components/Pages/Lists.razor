@page "/lists"
@rendermode InteractiveServer
@inject IHttpClientFactory HttpClientFactory
@using Application.Models.Dto.Responses;
@using static Blazor.Components.Enums;

<PageTitle>Lists</PageTitle>

<h1>My Lists</h1>

@if (favoriteMovies == null || favoriteTV == null)
{
	<p>Loading...</p>
}
else
{
	<MediaRow Title="Favorite Movies" mediaType="MediaType.Movies" category="Category.Favorite" endpoint="/api/Account/favourite/movies" movies="favoriteMovies" />
	<MediaRow Title="Favorite TV Shows" mediaType="MediaType.Tv" category="Category.Favorite" endpoint="/api/Account/favourite/tv" tvs="favoriteTV" />
}

@code {
	private MovieListResponseDto? favoriteMovies;
	private TvShowListResponseDto? favoriteTV;

	protected override async Task OnInitializedAsync()
	{
		var client = HttpClientFactory.CreateClient("MovieLibraryApi");
		favoriteMovies = await client.GetFromJsonAsync<MovieListResponseDto>("/api/Account/favourite/movies");
		favoriteTV = await client.GetFromJsonAsync<TvShowListResponseDto>("/api/Account/favourite/tv");
	}
}
