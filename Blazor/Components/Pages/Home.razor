@page "/"
@page "/movies"
@inject IHttpClientFactory HttpClientFactory
@using Application.Models.Dto.Responses;

<PageTitle>Movies and TV homepage</PageTitle>

@if (movies == null)
{
	<p>Loading...</p>
} else
{
	<p>Page @movies.Page of @movies.TotalPages</p>
	@foreach (var movie in movies.Results)
	{
		<div>@movie.Title</div>
	}
}

@code {
	private MovieListResponseDto? movies;

	protected override async Task OnInitializedAsync()
	{
		var client = HttpClientFactory.CreateClient("MovieLibraryApi");
		movies = await client.GetFromJsonAsync<MovieListResponseDto>("/api/trending/movies");
	}
}