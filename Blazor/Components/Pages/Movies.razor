@page "/movies"
@inject IHttpClientFactory HttpClientFactory
@using Application.Models.Dto.Responses;
@using Blazor.Components.Shared.MediaRow;

<PageTitle>Movies</PageTitle>

<h1>Movies</h1>

@if (popular == null || topRated == null || upcoming == null)
{
	<p>Loading...</p>
}
else
{
	<MediaRow Title="Popular" movies="popular" />
	<MediaRow Title="Top Rated" movies="topRated" />
	<MediaRow Title="Upcoming" movies="upcoming" />
}

@code {
	private MovieListResponseDto? popular;
	private MovieListResponseDto? topRated;
	private MovieListResponseDto? upcoming;

	protected override async Task OnInitializedAsync()
	{
		var client = HttpClientFactory.CreateClient("MovieLibraryApi");
		popular = await client.GetFromJsonAsync<MovieListResponseDto>("/api/movielists/popular");
		topRated = await client.GetFromJsonAsync<MovieListResponseDto>("/api/movielists/top-rated");
		upcoming = await client.GetFromJsonAsync<MovieListResponseDto>("/api/movielists/upcoming");
	}
}
