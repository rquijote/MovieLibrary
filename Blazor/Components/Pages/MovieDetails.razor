@page "/movie/{id:int}"
@rendermode InteractiveServer
@inject IHttpClientFactory httpClientFactory
@using Application.Enums
@using Application.Models.Dto.Requests
@using Application.Models.Dto.Responses

@if (movie != null)
{
	<div class="movie-details">
		<div class="movie-header">
			@if (!string.IsNullOrEmpty(movie.BackdropPath))
			{
				<div class="movie-backdrop">
					<h3>Backdrop Image</h3>
					<img src="@GetImageUrl(movie.BackdropPath)" alt="@movie.Title backdrop" />
				</div>
			}
			@if (!string.IsNullOrEmpty(movie.PosterPath))
			{
				<img src="@GetImageUrl(movie.PosterPath)" alt="@movie.Title" class="movie-poster" />
			}
			else if (!string.IsNullOrEmpty(movie.BackdropPath))
			{
				<img src="@GetImageUrl(movie.BackdropPath)" alt="@movie.Title" class="movie-poster" />
			}

			<div class="movie-info">
				<h1>@movie.Title</h1>

				@if (!string.IsNullOrEmpty(movie.OriginalTitle) && movie.OriginalTitle != movie.Title)
				{
					<p><strong>Original Title:</strong> @movie.OriginalTitle</p>
				}

				<p><strong>Release Date:</strong> @movie.ReleaseDate</p>
				@if (movie.Runtime.HasValue)
				{
					<p><strong>Runtime:</strong> @movie.Runtime min</p>
				}
				<p><strong>Rating:</strong> @movie.VoteAverage.ToString("F1") / 10 (@movie.VoteCount votes)</p>
				<p><strong>Popularity:</strong> @movie.Popularity.ToString("F1")</p>
				<p><strong>Original Language:</strong> @movie.OriginalLanguage.ToUpper()</p>
				<p><strong>ID:</strong> @movie.Id</p>

				<div>
					<button @onclick="AddToWatchlist">Add to Watchlist</button>
					<button @onclick="RemoveFromWatchlist">Remove from Watchlist</button>
				</div>
				<div>
					<button @onclick="AddToFavorites">Add to Favorites</button>
					<button @onclick="RemoveFromFavorites">Remove from Favorites</button>
				</div>
				<div>
					<input type="number" min="1" @bind="listId" />
					<button @onclick="AddToList">Add to List</button>
					<button @onclick="RemoveFromList">Remove from List</button>
				</div>
				<div>
					<input type="number" min="0.5" max="5" step="0.5" @bind="ratingOutOfFive" />
					<button @onclick="RateMovie">Rate (x2 sent to API)</button>
					<button @onclick="DeleteRating">Remove Rating</button>
				</div>
				@if (!string.IsNullOrEmpty(actionStatus))
				{
					<p>@actionStatus</p>
				}

				@if (movie.Video)
				{
					<p><strong>Has Video:</strong> Yes</p>
				}
			</div>
		</div>

		@if (!string.IsNullOrEmpty(movie.Overview))
		{
			<div class="movie-overview">
				<h2>Overview</h2>
				<p>@movie.Overview</p>
			</div>
		}

		@if (movie.Genres.Count > 0)
		{
			<div class="movie-genres">
				<h3>Genres</h3>
				<p>@string.Join(", ", movie.Genres.Select(g => g.Name))</p>
			</div>
		}
		else if (movie.GenreIds.Count > 0)
		{
			<div class="movie-genres">
				<h3>Genre IDs</h3>
				<p>@string.Join(", ", movie.GenreIds)</p>
			</div>
		}
	</div>
}
else if (isLoading)
{
	<p>Loading...</p>
}
else
{
	<p>Movie not found.</p>
}

@code {
	[Parameter]
	public int Id { get; set; }

	private MovieDto? movie;
	private bool isLoading = true;
	private int listId;
	private double ratingOutOfFive = 2.5;
	private string? actionStatus;

	protected override async Task OnParametersSetAsync()
	{
		await LoadMovieDetails();
	}

	private async Task LoadMovieDetails()
	{
		isLoading = true;
		actionStatus = null;
		var client = httpClientFactory.CreateClient("MovieLibraryApi");

		try
		{
			movie = await client.GetFromJsonAsync<MovieDto>($"/api/Movie/{Id}");
		}
		catch (Exception)
		{
			movie = null;
		}
		finally
		{
			isLoading = false;
		}
	}

	private async Task AddToWatchlist() =>
		await UpdateStatus(async client => await client.PostAsJsonAsync("/api/account/watchlist",
			new AddMediaWatchlistDto { Media = MediaType.movie, MediaId = Id, AddToList = true }));

	private async Task RemoveFromWatchlist() =>
		await UpdateStatus(async client => await client.PostAsJsonAsync("/api/account/watchlist",
			new AddMediaWatchlistDto { Media = MediaType.movie, MediaId = Id, AddToList = false }));

	private async Task AddToFavorites() =>
		await UpdateStatus(async client => await client.PostAsJsonAsync("/api/account/favorite",
			new AddMediaFavoriteDto { Media = MediaType.movie, MediaId = Id, AddToList = true }));

	private async Task RemoveFromFavorites() =>
		await UpdateStatus(async client => await client.PostAsJsonAsync("/api/account/favorite",
			new AddMediaFavoriteDto { Media = MediaType.movie, MediaId = Id, AddToList = false }));

	private async Task AddToList()
	{
		if (listId <= 0)
		{
			actionStatus = "Please enter a valid list ID.";
			return;
		}

		await UpdateStatus(async client => await client.PostAsJsonAsync($"/api/lists/{listId}/add_item",
			new ListMediaItemDto { MediaId = Id }));
	}

	private async Task RemoveFromList()
	{
		if (listId <= 0)
		{
			actionStatus = "Please enter a valid list ID.";
			return;
		}

		await UpdateStatus(async client => await client.PostAsJsonAsync($"/api/lists/{listId}/remove_item",
			new ListMediaItemDto { MediaId = Id }));
	}

	private async Task RateMovie()
	{
		if (ratingOutOfFive is < 0.5 or > 5)
		{
			actionStatus = "Rating must be between 0.5 and 5.";
			return;
		}

		var tmdbRating = ratingOutOfFive * 2;
		await UpdateStatus(async client => await client.PostAsync($"/api/movie/{Id}/rating?rating={tmdbRating}", null));
	}

	private async Task DeleteRating() =>
		await UpdateStatus(async client => await client.DeleteAsync($"/api/movie/{Id}/rating"));

	private async Task UpdateStatus(Func<HttpClient, Task<HttpResponseMessage>> request)
	{
		var client = httpClientFactory.CreateClient("MovieLibraryApi");
		var response = await request(client);
		var status = await response.Content.ReadFromJsonAsync<StatusDto>();
		actionStatus = status?.StatusMessage ?? response.ReasonPhrase ?? "Request completed.";
	}

	private string GetImageUrl(string? imagePath)
	{
		if (string.IsNullOrEmpty(imagePath))
			return "https://via.placeholder.com/500x750?text=No+Image";

		return $"https://image.tmdb.org/t/p/w500{imagePath}";
	}
}
