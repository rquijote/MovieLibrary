@inject IHttpClientFactory http;
@using Application.Models.Dto.Responses;
@inject NavigationManager Nav;

<div class="media-row-container">
	<div class="media-row-header">
		<h3>@Title</h3>
		<button class="view-more-btn" @onclick="ViewMore">View More</button> <!-- Make this a bool if results is over a certain amount. -->
	</div>
	<div class="media-row">
		@if (movies != null) 
		{
			@foreach (var movie in movies.Results)
			{
				<MediaRowItem title="@movie.Title" posterPath="@movie.PosterPath"/>
			}
		} 
		else if (tvs != null) 
		{
			@foreach (var tv in tvs.Results)
			{
				<MediaRowItem title="@tv.Name" posterPath="@tv.PosterPath"/>
			}
		}
	</div>
</div>


@code {
	[Parameter]
	public required string Title { get; set; }
	[Parameter]
	public MovieListResponseDto? movies { get; set; }
	[Parameter]
	public TvShowListResponseDto? tvs { get; set; }

	private void ViewMore()
	{
		Nav.NavigateTo("/view-more/type");
	}
}
