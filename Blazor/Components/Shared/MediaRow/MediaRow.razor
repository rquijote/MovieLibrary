@inject IHttpClientFactory http;
@using Application.Models.Dto.Responses;
@using static Blazor.Components.Enums;
@inject NavigationManager Nav;

<div class="media-row-container">
	<div class="media-row-header">
		<h3>@Title</h3>
		<button class="view-more-btn" @onclick="ViewMore">View More</button>
	</div>
	<div class="media-row">
		@if (movies != null) 
		{
			@foreach (var movie in movies.Results)
			{
				<MediaRowItem title="@movie.Title" posterPath="@movie.PosterPath" id="@movie.Id" mediaType="@mediaType" />
			}
		} 
		else if (tvs != null) 
		{
			@foreach (var tv in tvs.Results)
			{
				<MediaRowItem title="@tv.Name" posterPath="@tv.PosterPath" id="@tv.Id" mediaType="@mediaType" />
			}
		}
	</div>
</div>


@code {
	[Parameter]
	public required string Title { get; set; }
	[Parameter]
	public MovieListResponseDto? movies { get; set; }
	[Parameter]
	public TvShowListResponseDto? tvs { get; set; }
	[Parameter]
	public MediaType mediaType { get; set; }
	[Parameter]
	public Category category { get; set; }

	private void ViewMore()
	{
		var mediaTypeStr = mediaType switch
		{
			MediaType.Movies => "movies",
			MediaType.Tv => "tv",
			_ => "movies"
		};

		var categoryStr = category switch
		{
			Category.Popular => "popular",
			Category.TopRated => "top-rated",
			Category.Trending => "trending",
			Category.Watchlist => "watchlist",
			Category.Favorite => "favorite",
			Category.NowPlaying => "now-playing",
			Category.Upcoming => "upcoming",
			Category.AiringToday => "airing-today",
			Category.OnTheAir => "on-the-air",
			_ => "popular"
		};

		// Navigate with clean URL
		Nav.NavigateTo($"/{mediaTypeStr}/{categoryStr}");
	}
}
