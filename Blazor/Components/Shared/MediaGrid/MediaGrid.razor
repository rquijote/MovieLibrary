@inject NavigationManager NavigationManager
@using Application.Models.Dto.Responses;
@using static Blazor.Components.Enums;

<div class="media-grid">
	@if (MediaType == Blazor.Components.Enums.MediaType.Movies && Items is IEnumerable<MovieDto> movies)
	{
		@foreach (var movie in movies)
		{
			<div class="media-grid-item" @onclick="() => NavigateToMovie(movie.Id)">
				<img src="@GetImageUrl(movie.PosterPath)" alt="@movie.Title" />
				<h4>@movie.Title</h4>
				<p>@movie.ReleaseDate</p>
			</div>
		}
	}
	else if (MediaType == Blazor.Components.Enums.MediaType.Tv && Items is IEnumerable<TvShowDto> tvShows)
	{
		@foreach (var show in tvShows)
		{
			<div class="media-grid-item" @onclick="() => NavigateToTvShow(show.Id)">
				<img src="@GetImageUrl(show.PosterPath)" alt="@show.Name" />
				<h4>@show.Name</h4>
				<p>@show.FirstAirDate</p>
			</div>
		}
	}
</div>

@code {
	[Parameter]
	public object? Items { get; set; }

	[Parameter]
	public MediaType MediaType { get; set; }

	private string GetImageUrl(string? posterPath)
	{
		if (string.IsNullOrEmpty(posterPath))
			return "https://via.placeholder.com/300x450?text=No+Image";

		return $"https://image.tmdb.org/t/p/w500{posterPath}";
	}

	private void NavigateToMovie(int movieId)
	{
		NavigationManager.NavigateTo($"/movie/{movieId}");
	}

	private void NavigateToTvShow(int tvShowId)
	{
		NavigationManager.NavigateTo($"/tv/{tvShowId}");
	}
}
